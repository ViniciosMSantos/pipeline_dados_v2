# Copie para ".env" (não versionado) e preencha com os valores reais.

# UID do seu usuário no host, para o Airflow não escrever logs/dags como root.
# Descubra com: id -u
AIRFLOW_UID=1000

# GID do grupo "docker" no host, para as tasks conseguirem falar com o
# daemon Docker via /var/run/docker.sock (docker-outside-of-docker).
# Descubra com: getent group docker | cut -d: -f3
DOCKER_GID=999

# Login inicial da UI do Airflow (http://localhost:8080), criado pelo airflow-init.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Token do Databricks usado pelo target "dev" do profiles.yml.
DBT_DATABRICKS_TOKEN=

# Caminhos ABSOLUTOS no HOST (não no container do Airflow) — as tasks rodam
# `docker run -v ...` contra o daemon do host, então precisam do path real.
DBT_CORE_HOST_PATH=/caminho/absoluto/para/pipeline_dados_v2/dbt_core
DBT_PROFILES_HOST_PATH=/home/seu_usuario/.dbt
